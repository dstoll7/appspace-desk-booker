<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly Appspace desk booking. Runs book_week.py on several mornings (Thu-Mon)
  so that if the laptop is closed/asleep on one day, a later day catches it.

  book_week.py records what it booked in .book_week_state.json, so only the FIRST
  run each week that finds an unbooked day opens a browser (Okta push); the other
  mornings exit silently with nothing to do.

  launchd catch-up: if the Mac is asleep at the scheduled time, the job runs on
  wake; if logged out / powered off, it runs at the next login. So it effectively
  "runs when the laptop opens" if you miss the scheduled time.

  Install:   cp this file to ~/Library/LaunchAgents/ && launchctl load it
  Uninstall: launchctl unload ~/Library/LaunchAgents/com.dstoll.appspace-book-week.plist && rm it
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dstoll.appspace-book-week</string>

    <!--
      Runs the wrapper (run_book_week.sh), NOT book_week.py directly. The wrapper
      waits for network after wake and fires a macOS notification on failure so a
      silent failure can't cost a whole week again.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/daniel.stoll/GitHub/appspace-desk-booker/run_book_week.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/daniel.stoll/GitHub/appspace-desk-booker</string>

    <!--
      Fire twice a day (10:00 and 14:00) EVERY day. The idempotency guard in
      book_week.py keeps runs silent (no browser) once the week is already
      booked, so daily coverage just means more chances to catch you present to
      approve the Okta push — and a same-day failure notification any day a
      booking is still needed. The 14:00 slot is an automatic second attempt if
      the 10:00 run failed (no network / push not approved).
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- Do NOT RunAtLoad: we don't want a browser at every login, only on schedule/wake. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/daniel.stoll/Library/Logs/appspace-book-week.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/daniel.stoll/Library/Logs/appspace-book-week.log</string>
</dict>
</plist>
