<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dstoll.appspace-monitor</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Script lives in ~/Library/Scripts/ — launchd can execute it without FDA.
             The actual Python refresh runs inside Terminal.app (which has FDA) via osascript.
             After updating the launcher script, run: launchctl kickstart -k gui/$(id -u)/com.dstoll.appspace-monitor -->
        <string>/bin/bash</string>
        <string>/Users/daniel.stoll/Library/Scripts/appspace-monitor-launcher.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/appspace-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/appspace-monitor.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
